  "serial": ["bs/U3_responsive", "bs/R7_stream_and_cancel"],
  "known_failures": {
    "about": "A file here that fails is KNOWN only for its known reason: every top-level 'not ok' in its log is one of `failing`, and the log holds `crash` when one is given (else the run reached brittle's summary). Any other failure of the file is FAIL. Remove an entry once its file passes. (F3, 2026-11-13)",
    "test/doctor.test.js": {
      "about": "host-dependent checks; failing before 261111_buffer-search (baseline.md)",
      "failing": ["doctor: run() reports every check and exits 0 on this machine"]
    },
    "test/native-linkage.test.js": {
      "about": "flags libnode on this host; failing before 261111_buffer-search (baseline.md)",
      "failing": ["native-linkage: scan follows the dependency graph and flags libnode"]
    },
    "test/zxterm-seam.test.js": {
      "about": "exits 1 (E_BACKEND_UNSUPPORTED) with no 'not ok'; failing before 261111_buffer-search (baseline.md)",
      "failing": [],
      "crash": "Error: no such seam method: test.echo"
    }
  },
  "self": {
    "about": "Changes to these files select sanity plus the self-check (run.sh --self-check: the index against the tree, the selection rules on fixed cases, the KNOWN rule on fixture logs, --list and --dry-run); --full runs it too. (F3)",
    "paths": ["docs/acceptance/run.sh", "docs/acceptance/index.json"]
  },
  "docs_only": {
    "about": "A changed file matching these selects nothing beyond sanity, before any other rule: notes, goal pages, reports and kit READMEs. (F3)",
    "paths": ["docs/*.md"]
  },
  "harness": {
    "about": "Shared kit files and the kits whose scripts use them: a change selects every topic that lists a script of those kits. Any other non-script file in a kit's directory (activate, run_all.sh, its own helpers) does the same for its own kit; a changed R*/U* script selects the topics that list it. (F3)",
    "docs/projects/261110_ui-chrome/acceptance/lib.sh": ["uc", "tf", "st", "bs", "up"],
    "docs/projects/261110_ui-chrome/acceptance/color.jq": ["uc", "tf", "st", "bs"]
  },

{
  "name": "zbterm-core",
  "version": "1.0.0",
  "description": "ZBTerm's host-independent core: session recording, sharing, playback and identity, plus the sidecar launcher that supervises it.",
  "license": "Apache-2.0",
  "author": "David Achitov",
  "type": "commonjs",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "*.js",
    "backends/",
    "identity/",
    "rpc/"
  ],
  "imports": {
    "fs": {
      "bare": "bare-fs",
      "default": "fs"
    },
    "path": {
      "bare": "bare-path",
      "default": "path"
    },
    "os": {
      "bare": "bare-os",
      "default": "os"
    },
    "crypto": {
      "bare": "bare-crypto",
      "default": "crypto"
    },
    "events": {
      "bare": "bare-events",
      "default": "events"
    }
  },
  "dependencies": {
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "b4a": "^1.8.1",
    "bare-crypto": "^1.15.3",
    "bare-events": "^2.8.3",
    "bare-fs": "^4.7.1",
    "bare-os": "^3.9.1",
    "bare-path": "^3.0.0",
    "bare-process": "^4.4.1",
    "bare-sidecar": "^0.5.7",
    "compact-encoding": "^3.5.2",
    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hyperbee": "^2.27.3",
    "hypercore": "^11.37.0",
    "keet-identity-key": "^3.2.0",
    "protomux": "^3.11.0",
    "sodium-native": "^5.1.0"
  },
  "optionalDependencies": {
    "@freenetorg/freenet-stdlib": "^0.4.0",
    "bare-encoding": "^1.0.3",
    "bare-ws": "^3.2.0",
    "bs58": "^6.0.0",
    "hyperdht": "^6.34.0",
    "hyperswarm": "^4.17.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zevix/zbterm.git",
    "directory": "engine"
  },
  "bugs": {
    "url": "https://github.com/zevix/zbterm/issues"
  },
  "homepage": "https://github.com/zevix/zbterm#readme"
}
